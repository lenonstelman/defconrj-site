---
/* ============================================================
   DCG5521 — FOOTER v2 (portado de components/dcg-footer.tsx)
   Logo central com glitch · Anel HUD rotativo · Circuitos
   ============================================================ */
import site from '../data/site.json';

const { links, nome_publico } = site;
const ano = new Date().getFullYear();

const linksEsquerda = [
  { label: 'DISCORD', href: links.discord },
  { label: 'TELEGRAM', href: links.telegram },
  { label: 'INSTAGRAM', href: links.instagram },
].filter((link) => Boolean(link.href));

const linksDireita = [
  { label: 'LINKEDIN', href: links.linkedin },
  { label: 'E-MAIL', href: links.email ? `mailto:${links.email}` : '' },
  { label: 'GITHUB', href: links.github },
  { label: 'DEFCONGROUPS.ORG', href: 'https://defcongroups.org' },
].filter((link) => Boolean(link.href));
---

<footer class="footer-section">
  {/* Desconexão */}
  <div class="footer-disconnect">
    <span class="dc-icon" aria-hidden="true"></span>
    <span class="dc-text">disconnecting from dcg5521 network...</span>
    <span class="dc-line" aria-hidden="true"></span>
  </div>

  {/* Main: links | logo | links */}
  <div class="footer-main">
    {/* Left links */}
    <nav class="footer-col left" aria-label="Redes sociais">
      {
        linksEsquerda.map((l) => (
          <a href={l.href} class="footer-link" target="_blank" rel="noopener noreferrer">
            <span class="link-ping" aria-hidden="true" />
            {l.label}
          </a>
        ))
      }
    </nav>

    {/* Logo central */}
    <div class="logo-stage">
      {/* Anel HUD rotativo */}
      <svg class="logo-hud" viewBox="0 0 220 220" fill="none" aria-hidden="true">
        <circle cx="110" cy="110" r="105" stroke="#222" stroke-width="0.5" stroke-dasharray="4 6" />
        <circle cx="110" cy="110" r="95" stroke="#f23042" stroke-width="0.3" opacity="0.3" />
        <g stroke="#333" stroke-width="0.5">
          <line x1="110" y1="5" x2="110" y2="15" />
          <line x1="110" y1="205" x2="110" y2="215" />
          <line x1="5" y1="110" x2="15" y2="110" />
          <line x1="205" y1="110" x2="215" y2="110" />
        </g>
        <g stroke="#f23042" stroke-width="0.3" opacity="0.25">
          <line x1="110" y1="40" x2="110" y2="70" />
          <line x1="110" y1="150" x2="110" y2="180" />
          <line x1="40" y1="110" x2="70" y2="110" />
          <line x1="150" y1="110" x2="180" y2="110" />
        </g>
        <circle cx="110" cy="110" r="88" stroke="#333" stroke-width="0.3" stroke-dasharray="1 8" opacity="0.4" />
      </svg>

      {/* Circuitos saindo da logo */}
      <div class="circuit-arms" aria-hidden="true">
        <span class="c-arm a-left"></span>
        <span class="c-arm a-right"></span>
        <span class="c-arm a-tl"></span>
        <span class="c-arm a-tr"></span>
        <span class="c-arm a-bl"></span>
        <span class="c-arm a-br"></span>
      </div>

      {/* Logo com glitch */}
      <div class="logo-container">
        <img
          src="/assets/marca/logo-defcon-rj.png"
          alt={`Selo do ${nome_publico}`}
          width="170"
          height="170"
          loading="lazy"
        />
        <div class="logo-scan" aria-hidden="true"></div>
      </div>
    </div>

    {/* Right links */}
    <nav class="footer-col right" aria-label="Contato e código">
      {
        linksDireita.map((l) => (
          <a href={l.href} class="footer-link" target="_blank" rel="noopener noreferrer">
            {l.label}
            <span class="link-ping" aria-hidden="true" />
          </a>
        ))
      }
    </nav>
  </div>

  {/* Disclaimer */}
  <div class="footer-disclaimer">
    <p>
      <strong>{nome_publico}</strong> é um DEF CON Group independente, afiliado à
      comunidade DEF CON.
    </p>
    <div class="footer-bottom">
      <span>Hack. Learn. Share.</span>
      <span class="dot">·</span>
      <span>Build the community.</span>
      <span class="dot">·</span>
      <span>{ano}</span>
      <span class="dot">·</span>
      <span class="footer-coords">-22.9068° S / -43.1729° W</span>
    </div>
  </div>

  {/* Circuito */}
  <div class="footer-circuit" aria-hidden="true">
    <div class="fc-line"></div>
    <div class="fc-node"></div>
    <div class="fc-line"></div>
    <div class="fc-node"></div>
    <div class="fc-line"></div>
    <div class="fc-node"></div>
    <div class="fc-line"></div>
  </div>
</footer>
